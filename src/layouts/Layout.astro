---
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	accent?: string;
}

const { title, description, accent } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/images/logo.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@400;600;700&family=Inter:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body
		class="font-[Inter] antialiased"
		style={accent ? `--accent: ${accent};` : undefined}
	>
		<header class="flex items-center justify-between px-6 sm:px-10 py-6 max-w-6xl mx-auto">
			<a href="/" class="flex items-center gap-2.5">
				<img src="/images/logo.png" alt="Doppel Studios" class="h-7 w-auto" />
				<span class="font-heading font-bold tracking-wide text-sm sm:text-base">DOPPEL STUDIOS</span>
			</a>
			<nav class="flex gap-8 text-sm text-[var(--text-muted)]">
				<a href="/#games" class="hover:text-[var(--text)] transition-colors">Games</a>
				<a href="/contact" class="hover:text-[var(--text)] transition-colors">Contact</a>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer class="max-w-6xl mx-auto px-6 sm:px-10 py-10 text-sm text-[var(--text-muted)] flex flex-col sm:flex-row justify-between gap-4 border-t border-[var(--border)] mt-24">
			<p>&copy; {new Date().getFullYear()} Doppel Studios LLC</p>
			<div class="flex gap-6">
				<a href="mailto:ryan.bass@doppelstudios.com" class="hover:text-[var(--text)] transition-colors">Contact</a>
				<a href="/privacy" class="hover:text-[var(--text)] transition-colors">Privacy Policy</a>
			</div>
		</footer>
	</body>
</html>
