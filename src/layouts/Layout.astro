---
import '../styles/global.css';
import SocialIcons from '../components/SocialIcons.astro';

interface Props {
	title: string;
	description: string;
	accent?: string;
	/** Link-preview image path (1200x630). Defaults to the studio card. */
	image?: string;
}

const { title, description, accent, image = '/images/og-home.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/images/logo.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Doppel Studios" />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<link rel="canonical" href={canonical} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@400;600;700&family=Inter:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<!-- Umami Cloud analytics: cookie-free; counts only the real domain (ignores localhost/previews). -->
		<script
			defer
			src="https://cloud.umami.is/script.js"
			data-website-id="529b3712-daf6-475f-a2ed-7da3232f8384"
			data-domains="doppelstudios.com,www.doppelstudios.com"
		></script>
	</head>
	<body
		class="font-[Inter] antialiased"
		style={accent ? `--accent: ${accent};` : undefined}
	>
		<header class="sticky top-0 z-50 bg-[var(--bg)]/85 backdrop-blur border-b border-[var(--border)]">
			<div class="flex items-center justify-between px-6 sm:px-10 h-20 max-w-6xl mx-auto">
				<a href="/" class="flex items-center gap-2.5 h-full">
					<img src="/images/logo.png" alt="Doppel Studios" class="h-full w-auto" />
					<span class="font-heading font-bold tracking-wide text-base sm:text-lg text-[var(--brand-gold)]">DOPPEL STUDIOS</span>
				</a>
				<nav class="flex gap-8 text-sm text-[var(--text-muted)]">
					<a href="/#games" class="hover:text-[var(--text)] transition-colors">Games</a>
					<a href="/contact" class="hover:text-[var(--text)] transition-colors">Contact</a>
				</nav>
			</div>
		</header>
		<main>
			<slot />
		</main>
		<footer class="max-w-6xl mx-auto px-6 sm:px-10 py-10 text-sm text-[var(--text-muted)] flex flex-col sm:flex-row justify-between gap-4 border-t border-[var(--border)] mt-24">
			<p>&copy; {new Date().getFullYear()} Doppel Studios LLC</p>
			<div class="flex flex-wrap items-center gap-x-6 gap-y-3">
				<SocialIcons />
				<a href="mailto:ryan.bass@doppelstudios.com" class="hover:text-[var(--text)] transition-colors">Contact</a>
				<a href="/privacy" class="hover:text-[var(--text)] transition-colors">Privacy Policy</a>
			</div>
		</footer>
	</body>
</html>
