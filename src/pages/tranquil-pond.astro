---
import Layout from '../layouts/Layout.astro';
import AccentGlow from '../components/AccentGlow.astro';
import { games } from '../data/games';

const game = games.find((g) => g.slug === 'tranquil-pond')!;
---

<Layout
	title="Tranquil Pond — Doppel Studios"
	description="Tranquil Pond is a zen, meditative mobile game about thoughtfully filling your pond. Available on iOS and Android."
	accent={game.accent}
>
	<section class="relative overflow-hidden">
		<AccentGlow />
		<div class="relative max-w-3xl mx-auto px-6 py-20 text-center">
			<img
				src={game.icon}
				alt={game.name}
				class="w-28 h-28 mx-auto mb-8 rounded-3xl"
			/>
			<h1 class="font-heading text-4xl sm:text-5xl font-bold mb-4">{game.name}</h1>
			<p class="text-[var(--text-muted)] mb-10">{game.tagline}</p>

			<div class="flex items-center justify-center gap-4 mb-16 flex-wrap">
				<a href="https://apps.apple.com/us/app/tranquil-pond/id6477445076" target="_blank" rel="noopener">
					<img src="/images/app-store-badge.png" alt="Download on the App Store" class="h-12" />
				</a>
				<a href="https://play.google.com/store/apps/details?id=com.DoppelStudios.TranquilPond" target="_blank" rel="noopener">
					<img src="/images/google-play-badge.png" alt="Get it on Google Play" class="h-12" />
				</a>
			</div>

			<h2 class="font-heading text-2xl font-semibold mb-4">Join the Tranquil Community</h2>
			<div class="flex items-center justify-center gap-4 flex-wrap mb-16">
				<a
					href="https://discord.gg/Utw77kDXCk"
					target="_blank"
					rel="noopener"
					class="btn-accent inline-block px-8 py-3 rounded-full font-heading font-semibold transition-all"
				>
					Join Discord
				</a>
				<a
					href="/tranquil-pond/roadmap"
					class="btn-outline inline-block px-8 py-3 rounded-full font-heading font-semibold transition-colors"
				>
					View Development Roadmap
				</a>
			</div>

			<div>
				<h3 class="text-lg font-semibold mb-4 text-[var(--text-muted)]">Find more on socials</h3>
				<div class="flex justify-center gap-6 text-[var(--text-muted)]">
					<a href="https://www.instagram.com/tranquilpond/" target="_blank" rel="noopener" class="hover:text-[var(--text)] transition-colors">Instagram</a>
					<a href="https://www.tiktok.com/@tranquilpondgame" target="_blank" rel="noopener" class="hover:text-[var(--text)] transition-colors">TikTok</a>
					<a href="https://x.com/thetranquilpond" target="_blank" rel="noopener" class="hover:text-[var(--text)] transition-colors">X</a>
					<a href="https://www.youtube.com/@TranquilPondGame" target="_blank" rel="noopener" class="hover:text-[var(--text)] transition-colors">YouTube</a>
				</div>
			</div>
		</div>
	</section>
</Layout>
