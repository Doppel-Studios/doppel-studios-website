---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Tranquil Pond — Doppel Studios"
	description="Tranquil Pond is a zen, meditative mobile game about thoughtfully filling your pond. Available on iOS and Android."
>
	<section class="max-w-3xl mx-auto px-6 py-20 text-center">
		<img
			src="/images/tranquil-pond-icon.png"
			alt="Tranquil Pond"
			class="w-28 h-28 mx-auto mb-8 rounded-3xl"
		/>
		<h1 class="text-4xl sm:text-5xl font-bold mb-4">Tranquil Pond</h1>
		<p class="text-white/70 mb-10">tranquility is a ripple away</p>

		<div class="flex items-center justify-center gap-4 mb-16 flex-wrap">
			<a href="https://apps.apple.com/us/app/tranquil-pond/id6477445076" target="_blank" rel="noopener">
				<img src="/images/app-store-badge.png" alt="Download on the App Store" class="h-12" />
			</a>
			<a href="https://play.google.com/store/apps/details?id=com.DoppelStudios.TranquilPond" target="_blank" rel="noopener">
				<img src="/images/google-play-badge.png" alt="Get it on Google Play" class="h-12" />
			</a>
		</div>

		<h2 class="text-2xl font-semibold mb-4">Join the Tranquil Community</h2>
		<div class="flex items-center justify-center gap-4 flex-wrap mb-16">
			<a
				href="https://discord.gg/Utw77kDXCk"
				target="_blank"
				rel="noopener"
				class="inline-block px-8 py-3 rounded-full bg-white text-black font-semibold hover:bg-pink-200 transition-colors"
			>
				Join Discord
			</a>
			<a
				href="/tranquil-pond/roadmap"
				class="inline-block px-8 py-3 rounded-full border border-white/30 font-semibold hover:border-pink-300 hover:text-pink-200 transition-colors"
			>
				View Development Roadmap
			</a>
		</div>

		<div>
			<h3 class="text-lg font-semibold mb-4 text-white/80">Find more on socials</h3>
			<div class="flex justify-center gap-6 text-white/60">
				<a href="https://www.instagram.com/tranquilpond/" target="_blank" rel="noopener" class="hover:text-white">Instagram</a>
				<a href="https://www.tiktok.com/@tranquilpondgame" target="_blank" rel="noopener" class="hover:text-white">TikTok</a>
				<a href="https://x.com/thetranquilpond" target="_blank" rel="noopener" class="hover:text-white">X</a>
				<a href="https://www.youtube.com/@TranquilPondGame" target="_blank" rel="noopener" class="hover:text-white">YouTube</a>
			</div>
		</div>
	</section>
</Layout>
