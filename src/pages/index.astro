---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Doppel Studios — Thoughtful Games for Player Change"
	description="Doppel Studios makes thoughtful games for player change, starting with Tranquil Pond — a zen mobile game about tranquility."
>
	<section class="relative min-h-[80vh] flex items-center justify-center text-center overflow-hidden">
		<img
			src="/images/hero-pond.jpg"
			alt=""
			class="absolute inset-0 w-full h-full object-cover opacity-30"
		/>
		<div class="relative z-10 px-6 max-w-2xl mx-auto">
			<h1 class="text-4xl sm:text-6xl font-bold mb-4">Thoughtful Games for Player Change</h1>
			<h2 class="text-xl sm:text-2xl text-pink-200 mb-8">Tranquil Pond</h2>
			<p class="text-white/70 mb-10">tranquility is a ripple away</p>
			<a
				href="/tranquil-pond"
				class="inline-block px-8 py-3 rounded-full bg-white text-black font-semibold hover:bg-pink-200 transition-colors"
			>
				Learn More
			</a>
		</div>
	</section>

	<section class="max-w-xl mx-auto px-6 py-20 text-center">
		<h3 class="text-2xl font-semibold mb-3">Join our mailing list</h3>
		<p class="text-white/70 mb-8">
			Want to get updates on community events, learn about how we made the game, or find out
			what we're up to now?
		</p>
		<form class="flex flex-col sm:flex-row gap-3 justify-center">
			<input
				type="email"
				required
				placeholder="you@example.com"
				class="px-4 py-3 rounded-full bg-white/10 border border-white/20 text-white placeholder-white/40 focus:outline-none focus:border-pink-300 flex-1"
			/>
			<button
				type="submit"
				class="px-8 py-3 rounded-full bg-white text-black font-semibold hover:bg-pink-200 transition-colors"
			>
				Sign Up
			</button>
		</form>
	</section>
</Layout>
