---
import Layout from '../layouts/Layout.astro';
import AccentGlow from '../components/AccentGlow.astro';
import GameIcon from '../components/GameIcon.astro';
import MailingListForm from '../components/MailingListForm.astro';
import { games, stageLabels } from '../data/games';
---

<Layout
	title="Doppel Studios — Thoughtful Games for Player Change"
	description="Doppel Studios makes thoughtful games for player change, starting with Tranquil Pond — a zen mobile game about tranquility."
>
	<section class="relative overflow-hidden">
		<AccentGlow />
		<div class="relative max-w-3xl mx-auto px-6 py-28 sm:py-36 text-center">
			<h1 class="font-heading text-4xl sm:text-6xl font-bold mb-5 leading-tight">
				Thoughtful Games for<br class="hidden sm:block" /> Player Change
			</h1>
			<p class="text-[var(--text-muted)] text-lg mb-10 max-w-xl mx-auto">
				Doppel Studios is an indie studio crafting games meant to leave players a little
				different than it found them.
			</p>
			<a
				href="#games"
				class="btn-accent inline-block px-8 py-3 rounded-full font-heading font-semibold transition-all"
			>
				See Our Games
			</a>
		</div>
	</section>

	<section id="games" class="max-w-5xl mx-auto px-6 py-20 scroll-mt-20">
		<h2 class="font-heading text-2xl sm:text-3xl font-bold mb-10 text-center">Our Games</h2>
		<div class="grid sm:grid-cols-2 gap-6">
			{
				games.map((game) => (
					<a
						href={game.href}
						class="card-surface group rounded-2xl p-6 flex items-center gap-5 transition-colors hover:border-[var(--accent)]"
						style={`--accent: ${game.accent};`}
					>
						<GameIcon game={game} class="w-20 h-20 rounded-xl object-cover text-2xl" />
						<div class="min-w-0">
							<div class="flex items-center gap-2 mb-1">
								<h3 class="font-heading text-xl font-semibold">{game.name}</h3>
								{game.stage && (
									<span class="text-[10px] uppercase tracking-wide font-semibold px-2 py-0.5 rounded-full link-accent border border-current">
										{stageLabels[game.stage]}
									</span>
								)}
							</div>
							<p class="text-[var(--text-muted)] text-sm mb-2 truncate">{game.tagline}</p>
							<span class="text-sm font-medium link-accent">Learn more &rarr;</span>
						</div>
					</a>
				))
			}
			<div class="rounded-2xl p-6 flex items-center justify-center border border-dashed border-[var(--border)] text-[var(--text-muted)] text-sm text-center">
				More games in development
			</div>
		</div>
	</section>

	<section class="max-w-2xl mx-auto px-6 py-20">
		<div class="card-surface rounded-3xl px-8 py-12 text-center">
			<h3 class="font-heading text-2xl font-semibold mb-3">Join our mailing list</h3>
			<p class="text-[var(--text-muted)] mb-8">
				Want to get updates on community events, learn about how we made our games, or find out
				what we're up to now?
			</p>
			<MailingListForm buttonLabel="Sign Up" />
		</div>
	</section>
</Layout>
