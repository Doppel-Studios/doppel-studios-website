---
import Layout from '../layouts/Layout.astro';
import AccentGlow from '../components/AccentGlow.astro';
import BannerPlaceholder from '../components/BannerPlaceholder.astro';
import GameIcon from '../components/GameIcon.astro';
import MailingListForm from '../components/MailingListForm.astro';
import { games, stageLabels } from '../data/games';
import SocialIcons from '../components/SocialIcons.astro';
import { socialHandle } from '../data/socials';
import { iconPaths } from '../data/icons';

const game = games.find((g) => g.slug === 'gallery-gestalt')!;

const stageCopy = {
	beta: {
		supporting: 'Download, print, and play for free',
		mailingHeading: 'Get game updates',
		mailingBody:
			"Join our mail list and we'll let you know when the Kickstarter launches and what's coming next.",
	},
	kickstarter: {
		supporting: 'Help bring a custom deck of Gallery Gestalt cards to life.',
		mailingHeading: 'Miss the Kickstarter?',
		mailingBody: 'Join the mailing list to hear about future chances to grab a deck.',
	},
	store: {
		supporting: 'Grab your own deck and start making masterpieces.',
		mailingHeading: 'Stay in the loop',
		mailingBody: 'Sign up for updates on new games and expansions from Doppel Studios.',
	},
} as const;

const copy = game.stage ? stageCopy[game.stage] : undefined;
const isExternal = (href: string) => href.startsWith('http');
---

<Layout
	title="Gallery Gestalt — Doppel Studios"
	description="Gallery Gestalt is a free print-and-play tabletop game for ages 8+, 1–9 players, and 1–2 hours. Play artists making masterpieces for a gallery, responding to the momentous times around you."
	accent={game.accent}
	image="/images/og-gallery-gestalt.png"
>
	<!-- Shown only when someone arrives from the QR code on the rules (…/gallery-gestalt?ref=rules). -->
	<div id="played-banner" hidden class="border-b border-[var(--border)] bg-[color-mix(in_srgb,var(--accent)_16%,var(--bg))]">
		<div class="max-w-3xl mx-auto px-6 py-4 flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
			<p class="font-heading font-semibold">Thanks for playing! Two quick things:</p>
			<div class="flex gap-3">
				<a href="#survey" data-umami-event="qr-banner-survey" class="btn-accent px-5 py-2 rounded-full text-sm font-heading font-semibold">Take the survey</a>
				<a href="#join" data-umami-event="qr-banner-join" class="btn-outline px-5 py-2 rounded-full text-sm font-heading font-semibold">Join the list</a>
			</div>
		</div>
	</div>

	<section class="relative overflow-hidden">
		<AccentGlow />
		<BannerPlaceholder src={game.banner} />
		<div class="relative max-w-2xl mx-auto px-6 pt-40 sm:pt-64 pb-16 text-center">
			<GameIcon game={game} class="w-20 h-20 sm:w-28 sm:h-28 mx-auto mb-5 sm:mb-8 rounded-3xl text-3xl sm:text-4xl" />
			{game.stage && (
				<span class="btn-accent inline-block px-3 py-1 rounded-full text-xs font-heading font-semibold mb-4">
					{stageLabels[game.stage]}
				</span>
			)}
			{game.titleArt ? (
				<h1 class="mb-4 sm:mb-6">
					<img src={game.titleArt} alt={`${game.name}: ages 8+, 1–2 hours, 1–9 players`} class="mx-auto w-full max-w-[520px] h-auto" />
				</h1>
			) : (
				<h1 class="font-heading text-4xl sm:text-5xl font-bold mb-4">{game.name}</h1>
			)}
			<p class="text-[var(--text-muted)] text-base sm:text-lg mb-3 sm:mb-4 max-w-lg mx-auto">
				Play as artists in a unique world, making masterpieces for a gallery to respond to the
				momentous times around them.
			</p>
			{copy && (
				<p class="text-[var(--text-muted)] mb-6 sm:mb-10">{copy.supporting}</p>
			)}

			<div class="flex flex-wrap items-center justify-center gap-4">
				{game.primaryCTA && (
					<a
						href={game.primaryCTA.href}
						download={game.primaryCTA.download ? '' : undefined}
						data-umami-event="download-pdf"
						target={isExternal(game.primaryCTA.href) ? '_blank' : undefined}
						rel={isExternal(game.primaryCTA.href) ? 'noopener' : undefined}
						class="btn-accent inline-block px-8 py-3 rounded-full font-heading font-semibold transition-all"
					>
						{game.primaryCTA.label}
					</a>
				)}
				{game.secondaryCTA && (
					<a
						href={game.secondaryCTA.href}
						data-umami-event="click-itch"
						target={isExternal(game.secondaryCTA.href) ? '_blank' : undefined}
						rel={isExternal(game.secondaryCTA.href) ? 'noopener' : undefined}
						class="btn-outline inline-block px-8 py-3 rounded-full font-heading font-semibold transition-colors"
					>
						{game.secondaryCTA.label}
					</a>
				)}
			</div>
		</div>

		<div class="relative max-w-2xl mx-auto px-6 pb-24">
			<div class="text-center mb-10">
				<h2 class="font-heading text-lg font-semibold mb-2">Share your art</h2>
				<p class="text-[var(--text-muted)] text-sm mb-4">
					Made something you love? Post it with <span class="link-accent font-semibold">#GalleryGestalt</span> and tag <span class="font-semibold">{socialHandle}</span>.
				</p>
				<SocialIcons size="w-6 h-6" class="justify-center text-[var(--text-muted)]" />
			</div>

			<div class="card-surface rounded-3xl px-6 sm:px-8 py-4">
				<h2 class="font-heading text-2xl font-bold text-center pt-4 pb-2">How the beta works</h2>
				<ol class="divide-y divide-[var(--border)]">
					<li class="py-6 flex gap-4 items-start">
						<span class="btn-accent shrink-0 w-9 h-9 rounded-full flex items-center justify-center font-heading font-bold">1</span>
						<div>
							<h3 class="font-heading font-semibold mb-1">Get the game</h3>
							<p class="text-[var(--text-muted)] text-sm">Download the free PDF (or grab it on itch.io) and print it out. All you need is a deck of cards, paper, and something to draw with. The PDF is US Letter, landscape. On A4, choose "Fit to page" when printing.</p>
						</div>
					</li>
					<li class="py-6 flex gap-4 items-start">
						<span class="btn-accent shrink-0 w-9 h-9 rounded-full flex items-center justify-center font-heading font-bold">2</span>
						<div>
							<h3 class="font-heading font-semibold mb-1">Play</h3>
							<p class="text-[var(--text-muted)] text-sm">Gather some friends or enjoy solo playing as artists in a unique world. Find inspiration, make your masterpiece, then share your art at the gallery.</p>
						</div>
					</li>
					<li id="join" class="py-6 flex gap-4 items-start scroll-mt-24">
						<span class="btn-accent shrink-0 w-9 h-9 rounded-full flex items-center justify-center font-heading font-bold">3</span>
						<div class="flex-1 min-w-0">
							<h3 class="font-heading font-semibold mb-1">{copy?.mailingHeading ?? 'Join the list'}</h3>
							<p class="text-[var(--text-muted)] text-sm mb-4">
								{copy?.mailingBody ?? "Sign up to hear when it's ready to play."}
							</p>
							<MailingListForm buttonLabel="Join the List" tag="gallery-gestalt-beta" />
						</div>
					</li>
					<li id="survey" class="py-6 flex gap-4 items-start scroll-mt-24">
						<span class="btn-accent shrink-0 w-9 h-9 rounded-full flex items-center justify-center font-heading font-bold">4</span>
						<div class="flex-1 min-w-0 flex flex-col sm:flex-row sm:items-center gap-4">
							<div class="flex-1">
								<h3 class="font-heading font-semibold mb-1">Tell us what you think</h3>
								{game.survey ? (
									<p class="text-[var(--text-muted)] text-sm">A few quick questions. Honest feedback is the most useful thing you can give us.</p>
								) : (
									<p class="text-[var(--text-muted)] text-sm">The survey is coming soon. Join the list above and we'll send it to you.</p>
								)}
							</div>
							{game.survey && (
								<a
									href={game.survey.href}
								data-umami-event="click-survey"
									target="_blank"
									rel="noopener"
									class="btn-accent shrink-0 self-start sm:self-center inline-block px-8 py-3 rounded-full font-heading font-semibold transition-all"
								>
									{game.survey.label}
								</a>
							)}
						</div>
					</li>
				</ol>
			</div>

			{game.discord && (
				<div class="card-surface rounded-3xl p-6 sm:p-8 mt-6 flex flex-col sm:flex-row sm:items-center gap-5">
					<span class="shrink-0 w-12 h-12 rounded-2xl flex items-center justify-center bg-[color-mix(in_srgb,var(--accent)_18%,transparent)] text-[var(--accent)]">
						<svg viewBox="0 0 24 24" class="w-6 h-6" fill="currentColor" aria-hidden="true"><path d={iconPaths.Discord} /></svg>
					</span>
					<div class="flex-1">
						<h2 class="font-heading text-lg font-semibold mb-1">Join the Discord</h2>
						<p class="text-[var(--text-muted)] text-sm">
							For the true artists. Talk rules, swap art, and help shape where Gallery Gestalt goes next.
						</p>
					</div>
					<a
						href={game.discord}
						data-umami-event="click-discord"
						target="_blank"
						rel="noopener"
						class="btn-outline shrink-0 self-start sm:self-center inline-block px-8 py-3 rounded-full font-heading font-semibold transition-colors"
					>
						Join the Discord
					</a>
				</div>
			)}

			<p class="text-[var(--text-muted)] text-xs text-center mt-8 max-w-md mx-auto">
				Gallery Gestalt rules and artwork &copy; {new Date().getFullYear()} Doppel Studios LLC. All rights reserved. Free to download, print, and play for personal use. Please share the link, not the file, and do not modify, sell, or redistribute it.
			</p>
		</div>
	</section>

	<script is:inline>
		if (new URLSearchParams(location.search).get('ref') === 'rules') {
			document.getElementById('played-banner').hidden = false;
			window.addEventListener('load', function () {
				if (window.umami) window.umami.track('qr-visit');
			});
		}
	</script>
</Layout>
