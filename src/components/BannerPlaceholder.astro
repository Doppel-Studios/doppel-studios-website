---
interface Props {
	/** Real banner image path, once one exists. Falls back to a generated abstract placeholder. */
	src?: string;
}

const { src } = Astro.props;
---

<div
	class="pointer-events-none absolute inset-x-0 top-0 h-64 sm:h-80 overflow-hidden"
	style="mask-image: linear-gradient(to bottom, black 0%, black 25%, transparent 88%); -webkit-mask-image: linear-gradient(to bottom, black 0%, black 25%, transparent 88%);"
>
	{
		src ? (
			<img src={src} alt="" class="w-full h-full object-cover" />
		) : (
			<svg viewBox="0 0 1600 400" preserveAspectRatio="xMidYMid slice" class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
				<defs>
					<filter id="banner-soften" x="-20%" y="-20%" width="140%" height="140%">
						<feGaussianBlur stdDeviation="60" />
					</filter>
				</defs>
				<g filter="url(#banner-soften)">
					<circle cx="260" cy="150" r="220" style="fill: color-mix(in srgb, var(--accent) 55%, white); opacity: 0.5" />
					<circle cx="880" cy="50" r="260" style="fill: var(--accent); opacity: 0.42" />
					<circle cx="1340" cy="230" r="230" style="fill: color-mix(in srgb, var(--accent) 55%, black); opacity: 0.35" />
					<circle cx="620" cy="310" r="200" style="fill: var(--accent); opacity: 0.28" />
				</g>
			</svg>
		)
	}
</div>
