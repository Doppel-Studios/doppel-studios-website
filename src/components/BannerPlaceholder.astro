---
interface Props {
	/** Real banner image path, once one exists. Falls back to a generated abstract placeholder. */
	src?: string;
	/** Which edge of the image stays put when the strip crops it: the center (default), the top (crops from the bottom), or the bottom (crops from the top). */
	anchor?: 'center' | 'top' | 'bottom';
	/**
	 * Scale the strip's height with the window width (see .hero-fluid in global.css) so a wide banner
	 * shows in full, with a softer fade. The parent section needs the `hero-fluid` class.
	 */
	fluid?: boolean;
}

const { src, anchor = 'center', fluid = false } = Astro.props;
const fade = fluid
	? 'black 0%, black 55%, transparent 100%'
	: 'black 0%, black 25%, transparent 88%';
---

<div
	class:list={['pointer-events-none absolute inset-x-0 top-0 overflow-hidden', fluid ? 'banner-fluid' : 'h-40 sm:h-56']}
	style={`mask-image: linear-gradient(to bottom, ${fade}); -webkit-mask-image: linear-gradient(to bottom, ${fade});`}
>
	{
		src ? (
			<img src={src} alt="" class:list={['w-full h-full object-cover', anchor === 'top' && 'object-top', anchor === 'bottom' && 'object-bottom']} />
		) : (
			<svg viewBox="0 0 1600 400" preserveAspectRatio="xMidYMid slice" class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
				<defs>
					<filter id="banner-soften" x="-20%" y="-20%" width="140%" height="140%">
						<feGaussianBlur stdDeviation="60" />
					</filter>
				</defs>
				<g filter="url(#banner-soften)">
					<circle cx="260" cy="150" r="220" style="fill: color-mix(in srgb, var(--accent) 55%, white); opacity: 0.5" />
					<circle cx="880" cy="50" r="260" style="fill: var(--accent); opacity: 0.42" />
					<circle cx="1340" cy="230" r="230" style="fill: color-mix(in srgb, var(--accent) 55%, black); opacity: 0.35" />
					<circle cx="620" cy="310" r="200" style="fill: var(--accent); opacity: 0.28" />
				</g>
			</svg>
		)
	}
</div>
