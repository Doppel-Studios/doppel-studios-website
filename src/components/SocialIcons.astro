---
import { socials, type Social } from '../data/socials';
import { iconPaths } from '../data/icons';

interface Props {
	/** Tailwind size classes for each icon (default fits the footer). */
	size?: string;
	class?: string;
	/** Override which links to show (defaults to the studio-wide socials). */
	items?: Social[];
}

const { size = 'w-5 h-5', class: className = '', items = socials } = Astro.props;

---

<div class={`flex items-center gap-5 ${className}`}>
	{
		items.map((s) => (
			<a
				href={s.href}
				target="_blank"
				rel="noopener"
				aria-label={s.label}
				title={s.label}
				data-umami-event="social-click"
				data-umami-event-platform={s.label}
				class="transition-colors hover:text-[var(--accent)]"
			>
				<svg viewBox="0 0 24 24" class={size} fill="currentColor" aria-hidden="true">
					<path d={iconPaths[s.label]} />
				</svg>
			</a>
		))
	}
</div>
